{
  "name": "fuwari",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "predev": "pnpm subset-fonts",
    "dev": "astro dev",
    "start": "astro dev",
    "build": "pnpm subset-fonts && astro build && pagefind --site dist",
