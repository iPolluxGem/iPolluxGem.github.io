    "@iconify-json/ri": "^1.2.10",
    "@iconify-json/tabler": "^1.2.38",
    "@rollup/plugin-yaml": "^4.1.2",
    "@types/markdown-it": "^14.1.2",
    "@types/mdast": "^4.0.4",
    "@types/sanitize-html": "^2.13.0",
    "postcss-import": "^16.1.0",
    "postcss-nesting": "^13.0.1"
